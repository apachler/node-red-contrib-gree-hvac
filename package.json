{
  "name": "node-red-contrib-gree-hvac",
  "version": "1.6.7",
  "description": "A Node-RED integration for controlling Gree smart air conditioners",
  "author": "Igor Starovierov <igor.decler@gmail.com>",
  "contributors": [
    "Andreas Pachler <apachler@paan-systems.com>"
  ],
  "license": "MIT",
  "keywords": [
    "node-red",
    "node-red-contrib",
    "gree",
    "hvac",
    "air-conditioner",
    "ac",
    "climate",
    "iot",
    "udp"
  ],
  "homepage": "https://github.com/apachler/node-red-contrib-gree-hvac#readme",
  "bugs": {
    "url": "https://github.com/apachler/node-red-contrib-gree-hvac/issues"
  },
  "files": [
    "gree-hvac/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "gree-hvac": "gree-hvac/gree-hvac.js",
      "gree-hvac-config": "gree-hvac/gree-hvac-config.js",
      "gree-hvac-discover": "gree-hvac/gree-hvac-discover.js"
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint ./",
    "lint:fix": "eslint --fix ./",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --allowed-urls https://github.com/apachler/gree-hvac-client/releases/download/v4.3.0/gree-hvac-client-4.3.0.tgz --validate-https --validate-package-names",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,json}\"",
    "format": "prettier --write \"**/*.{md,yml,yaml,json}\"",
    "test": "node --test test/*.test.js",
    "test:sim": "node --test sim/test/*.test.js",
    "test:e2e": "node test/e2e/run-e2e.js",
    "coverage": "c8 node --test test/*.test.js sim/test/*.test.js",
    "coverage:check": "c8 --check-coverage node --test test/*.test.js sim/test/*.test.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "sim:up": "docker compose up -d --build",
    "sim:down": "docker compose down -v --remove-orphans",
    "sim:logs": "docker compose logs -f",
    "sim:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "sim:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down -v --remove-orphans",
    "nd": "node-red -u sandbox",
    "watch": "node --watch-path=gree-hvac \"$(npm root -g)/node-red/red.js\" -u sandbox"
  },
  "dependencies": {
    "gree-hvac-client": "https://github.com/apachler/gree-hvac-client/releases/download/v4.3.0/gree-hvac-client-4.3.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "lockfile-lint": "^4.14.1",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apachler/node-red-contrib-gree-hvac.git"
  }
}

# Local overrides for the docker-compose sim stack. Copy to `.env`
# (gitignored); `docker compose` / `npm run sim:up` load it automatically.

# Interface the sim (7000/udp, 8080) and Node-RED (1880) ports are published
# on. Neither has authentication, so the default is loopback only; use
# 0.0.0.0 to reach them from other machines on a trusted network.
GREE_BIND=127.0.0.1

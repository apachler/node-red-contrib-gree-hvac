[
    {
        "id": "mocks-tab",
        "type": "tab",
        "label": "🧪 Mocks (sim only)",
        "disabled": false,
        "info": "Pumps mock Victron + Ruuvi sensor values from the simulator container into the 'Collect Data' function in the main flow. This tab replaces the role of the Victron + Ruuvi input nodes when there is no Venus OS / dbus available.\n\nReads values from the simulator's HTTP API:\n  GET http://gree.lan:8080/api/sensors\n\nFor the dashboard / control logic to react, set values on the simulator dashboard at http://localhost:8080/, or use the 'Sim Sensors' dashboard page."
    },
    {
        "id": "mock-tick",
        "type": "inject",
        "z": "mocks-tab",
        "name": "Every 5s",
        "props": [
            { "p": "payload" }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "str",
        "x": 130,
        "y": 100,
        "wires": [
            ["mock-fetch"]
        ]
    },
    {
        "id": "mock-fetch",
        "type": "http request",
        "z": "mocks-tab",
        "name": "GET /api/sensors",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://gree.lan:8080/api/sensors",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 330,
        "y": 100,
        "wires": [
            ["mock-fanout"]
        ]
    },
    {
        "id": "mock-fanout",
        "type": "function",
        "z": "mocks-tab",
        "name": "Fan out to Daten sammeln",
        "func": "// Receives { soc, batteryVoltage, batterySystemStateNum, insideC, outsideC }\n// from the simulator's /api/sensors endpoint and emits one message per\n// sensor with a `path` field that matches the dispatch logic in the\n// 'Collect Data' function (which keys off substring matches in msg.path).\nvar s = msg.payload || {};\nif (typeof s !== 'object') {\n    node.warn('expected object payload from /api/sensors, got ' + typeof s);\n    return null;\n}\n\nif (typeof s.soc === 'number') {\n    node.send({ path: 'Battery SOC', payload: s.soc });\n}\nif (typeof s.batterySystemStateNum === 'number') {\n    node.send({ path: 'Battery State', payload: s.batterySystemStateNum });\n}\nif (typeof s.batteryVoltage === 'number') {\n    node.send({ path: 'Battery Voltage', payload: s.batteryVoltage });\n}\nif (typeof s.insideC === 'number') {\n    node.send({ path: 'Ruuvi Inside', payload: s.insideC });\n}\nif (typeof s.outsideC === 'number') {\n    node.send({ path: 'Ruuvi Outside', payload: s.outsideC });\n}\nnode.status({ fill: 'green', shape: 'dot', text: 'pumped ' + new Date().toISOString().slice(11,19) });\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            ["bc74c3718f91fdaa"]
        ]
    },
    {
        "id": "mock-debug",
        "type": "debug",
        "z": "mocks-tab",
        "name": "sensor payload",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 580,
        "y": 160,
        "wires": []
    },
    {
        "id": "mock-test-ac-on",
        "type": "inject",
        "z": "mocks-tab",
        "name": "Test: AC ON",
        "info": "e2e hook. The dashboard ui-button/ui-switch nodes can't be triggered over the admin /inject API (only plain inject nodes can), so this inject feeds the Gree node directly with an ON command. The e2e suite POSTs to /inject/mock-test-ac-on and asserts the simulator's AC turns on.",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "on",
        "payload": "{\"power\":\"on\",\"mode\":\"cool\",\"temperature\":21,\"fanSpeed\":\"high\"}",
        "payloadType": "json",
        "x": 320,
        "y": 240,
        "wires": [
            ["72f57580f5a03db9"]
        ]
    },
    {
        "id": "mock-test-ac-off",
        "type": "inject",
        "z": "mocks-tab",
        "name": "Test: AC OFF",
        "info": "e2e hook — feeds the Gree node directly with an OFF command. See 'Test: AC ON'.",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "off",
        "payload": "{\"power\":\"off\"}",
        "payloadType": "json",
        "x": 320,
        "y": 300,
        "wires": [
            ["72f57580f5a03db9"]
        ]
    },
    {
        "id": "sensor-form",
        "type": "ui-form",
        "z": "mocks-tab",
        "name": "Mock sensor form",
        "label": "Set mock Victron + Ruuvi values",
        "group": "sim-sensors-group",
        "order": 1,
        "width": 0,
        "height": 0,
        "options": [
            { "label": "Battery SOC (%)", "key": "soc", "type": "number", "required": true, "rows": null },
            { "label": "Battery voltage (V)", "key": "batteryVoltage", "type": "number", "required": true, "rows": null },
            { "label": "Battery state (0=idle 1=charging 2=discharging)", "key": "batterySystemStateNum", "type": "number", "required": true, "rows": null },
            { "label": "Inside temp (°C)", "key": "insideC", "type": "number", "required": true, "rows": null },
            { "label": "Outside temp (°C)", "key": "outsideC", "type": "number", "required": true, "rows": null }
        ],
        "formValue": {
            "soc": 78,
            "batteryVoltage": 53.7,
            "batterySystemStateNum": 1,
            "insideC": 24.5,
            "outsideC": 22
        },
        "payload": "",
        "submit": "Apply to simulator",
        "cancel": "Reset",
        "split": 4,
        "className": "",
        "x": 330,
        "y": 400,
        "wires": [
            ["sensor-form-post"]
        ]
    },
    {
        "id": "sensor-form-post",
        "type": "http request",
        "z": "mocks-tab",
        "name": "POST /api/sensors",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://gree.lan:8080/api/sensors",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 560,
        "y": 400,
        "wires": [
            ["sensor-form-result"]
        ]
    },
    {
        "id": "sensor-form-result",
        "type": "ui-text",
        "z": "mocks-tab",
        "group": "sim-sensors-group",
        "order": 2,
        "width": 0,
        "height": 0,
        "name": "Applied values",
        "label": "Stored in simulator:",
        "format": "SOC {{msg.payload.soc}}% · {{msg.payload.batteryVoltage}}V · state {{msg.payload.batterySystemStateNum}} · in {{msg.payload.insideC}}°C · out {{msg.payload.outsideC}}°C",
        "layout": "col-center",
        "style": false,
        "font": "",
        "fontSize": 14,
        "color": "#717171",
        "className": "",
        "x": 780,
        "y": 400,
        "wires": []
    },
    {
        "id": "sensor-form-load",
        "type": "inject",
        "z": "mocks-tab",
        "name": "Load current on startup",
        "info": "Prefills the form with the simulator's current sensor values once at startup, so the fields start from reality rather than hard-coded defaults. It does NOT refresh periodically — a periodic prefill would overwrite values while you are typing. The :8080 dashboard is the live view; this form is for setting values.",
        "props": [
            { "p": "payload" }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 330,
        "y": 460,
        "wires": [
            ["sensor-form-load-fetch"]
        ]
    },
    {
        "id": "sensor-form-load-fetch",
        "type": "http request",

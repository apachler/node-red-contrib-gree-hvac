    {
        "id": "ss-clock-handler",
        "type": "function",
        "z": "mocks-tab",
        "name": "Sim clock handler",
        "func": "// Maintains the GLOBAL-context sim-clock override read by the example\n// flow's 'Main Logic' and 'Dashboard Values' functions:\n//   global.simClock = { enabled: <bool>, hour: <0-23> }\n// Global (not flow) context is required because this handler lives on the\n// mocks tab while the readers live on the user-flow tab — flow context is\n// scoped per-tab and would not be shared. When disabled the flow falls\n// back to the real wall clock.\nvar sc = global.get('simClock') || { enabled: false, hour: 12 };\nif (msg.topic === 'enabled') {\n    sc.enabled = !!msg.payload;\n} else if (msg.topic === 'hour') {\n    sc.hour = Math.max(0, Math.min(23, Number(msg.payload)));\n}\nglobal.set('simClock', sc);\nnode.status({ fill: sc.enabled ? 'blue' : 'grey', shape: 'dot', text: sc.enabled ? ('Sim clock ' + sc.hour + ':00') : 'Real clock' });\nreturn { payload: sc.enabled ? ('🕐 Simulated ' + sc.hour + ':00 — flow uses this for the time-of-day gate') : '🕐 Real clock (enable the switch to simulate a time of day)' };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 1030,
        "wires": [

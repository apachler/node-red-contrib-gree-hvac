        "wires": [
            ["ss-fanout", "ss-fmt"]
        ]
    },
    {
        "id": "ss-fanout",
        "type": "function",
        "z": "mocks-tab",
        "name": "Prefill widgets",
        "func": "// Push the simulator's current values into each widget (passthru off, so\n// this does not trigger an apply/POST).\nvar s = msg.payload || {};\nreturn [\n    [{ payload: s.soc }],\n    [{ payload: s.batteryVoltage }],\n    [{ payload: s.batterySystemStateNum }],\n    [{ payload: s.insideC }],\n    [{ payload: s.outsideC }]\n];",
        "outputs": 5,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 620,
        "wires": [
            ["ss-soc"],
            ["ss-volt"],
            ["ss-state"],
            ["ss-inside"],
            ["ss-outside"]
        ]
    },

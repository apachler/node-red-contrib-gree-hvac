    {
        "id": "ss-apply",
        "type": "function",
        "z": "mocks-tab",
        "name": "Apply one value",
        "func": "// Each sensor widget emits { topic: <sensor key>, payload: <value> } on\n// change. Build a single-key patch and POST it to the simulator, which\n// applies a partial update. passthru is off on the widgets, so prefilling\n// them from the simulator does NOT re-trigger this.\nvar key = msg.topic;\nvar val = Number(msg.payload);\nif (!key || !Number.isFinite(val)) { return null; }\nvar body = {};\nbody[key] = val;\nmsg.payload = body;\nmsg.headers = { 'content-type': 'application/json' };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 460,
        "wires": [
            ["ss-post"]
        ]
    },
    {
        "id": "ss-post",
        "type": "http request",
        "z": "mocks-tab",
        "name": "POST /api/sensors",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://gree.lan:8080/api/sensors",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 660,
        "y": 400,
        "wires": [
            ["ss-fmt"]
        ]
    },
    {
        "id": "ss-fmt",
        "type": "function",
        "z": "mocks-tab",
        "name": "Format stored values",
        "func": "// Build a plain display string. Dashboard 2.0 ui-text renders the whole\n// payload object as '[object Object]' if you reference nested fields in\n// its format template, so we format here and show {{msg.payload}}.\nvar s = msg.payload || {};\nvar f = function (v) { return (v === undefined || v === null) ? '?' : v; };\nmsg.payload = 'SOC ' + f(s.soc) + '% · ' + f(s.batteryVoltage) + 'V · state ' + f(s.batterySystemStateNum) + ' · in ' + f(s.insideC) + '°C · out ' + f(s.outsideC) + '°C';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 520,
        "wires": [
            ["ss-result"]
        ]
    },

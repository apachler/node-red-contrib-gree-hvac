    {
        "id": "ss-clock-handler",
        "type": "function",
        "z": "mocks-tab",
        "name": "Sim clock handler",
        "func": "// Maintains the flow-context sim-clock override read by the example flow's\n// 'Main Logic' and 'Dashboard Values' functions:\n//   flow.simClock = { enabled: <bool>, hour: <0-23> }\n// When disabled the flow falls back to the real wall clock.\nvar sc = flow.get('simClock') || { enabled: false, hour: 12 };\nif (msg.topic === 'enabled') {\n    sc.enabled = !!msg.payload;\n} else if (msg.topic === 'hour') {\n    sc.hour = Math.max(0, Math.min(23, Number(msg.payload)));\n}\nflow.set('simClock', sc);\nnode.status({ fill: sc.enabled ? 'blue' : 'grey', shape: 'dot', text: sc.enabled ? ('Sim clock ' + sc.hour + ':00') : 'Real clock' });\nreturn { payload: sc.enabled ? ('🕐 Simulated: ' + sc.hour + ':00 (flow uses this for the time-of-day gate)') : '🕐 Real clock (live time-of-day)' };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 720,
        "wires": [
            ["ss-clock-info"]
        ]
    },

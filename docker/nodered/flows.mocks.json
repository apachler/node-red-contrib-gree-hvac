        "type": "inject",
        "z": "mocks-tab",
        "name": "Load current on startup",
        "info": "Prefills the widgets with the simulator's current sensor values once at startup, so they start from reality rather than hard-coded defaults. Does NOT refresh periodically — that would overwrite values while you are editing. The :8080 dashboard is the live view.",
        "props": [
            { "p": "payload" }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "2.5",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,

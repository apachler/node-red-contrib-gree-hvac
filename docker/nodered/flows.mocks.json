        "id": "ss-post",
        "type": "http request",
        "z": "mocks-tab",
        "name": "POST /api/sensors",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://gree.lan:8080/api/sensors",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,

    {
        "id": "ss-fmt",
        "type": "function",
        "z": "mocks-tab",
        "name": "Format stored values",
        "func": "// Build a plain display string. Dashboard 2.0 ui-text renders the whole\n// payload object as '[object Object]' if you reference nested fields in\n// its format template, so we format here and show {{msg.payload}}.\nvar s = msg.payload || {};\nvar f = function (v) { return (v === undefined || v === null) ? '?' : v; };\nmsg.payload = 'SOC ' + f(s.soc) + '% · ' + f(s.batteryVoltage) + 'V · state ' + f(s.batterySystemStateNum) + ' · in ' + f(s.insideC) + '°C · out ' + f(s.outsideC) + '°C';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1600,
        "y": 680,
        "wires": [
            [
                "ss-result"
            ]
        ]
    },

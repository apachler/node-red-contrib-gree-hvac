{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "arrowParens": "avoid",
    "tabWidth": 4,
    "overrides": [
        {
            "files": [
                "*.json",
                "*.md"
            ],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": [
                "*.yml",
                "*.yaml"
            ],
            "options": {
                "tabWidth": 2,
                "singleQuote": false
            }
        }
    ]
}

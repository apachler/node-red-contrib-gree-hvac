  {
    "id": "d4b0a5d000000011",
    "type": "function",
    "name": "Properties → widgets",
    "func": "// msg.payload: every property of the unit — the snapshot (output 2) after\n// each change, or the answer to the getProperties request of the timer.\nif (msg.topic !== 'properties' && msg.topic !== 'getProperties') {\n    return null; // another request's answer\n}\nconst p = msg.payload || {};\nconst set = value => (value === undefined ? null : { payload: value });\nconst sensor = (value, unit) =>\n    value === undefined || value === 0 ? '—' : value + ' ' + unit;\nconst unit = p.temperatureUnit === 'fahrenheit' ? '°F' : '°C';\nconst chart =\n    p.currentTemperature && p.temperature !== undefined\n        ? [\n              { topic: 'Room', payload: p.currentTemperature },\n              { topic: 'Setpoint', payload: p.temperature },\n          ]\n        : null;\n\nreturn [\n    set(p.power),\n    set(p.mode),\n    set(p.currentTemperature || undefined),\n    set(p.temperature),\n    set(p.fanSpeed),\n    set(p.swingVert),\n    // the switch shows any quiet mode as on, and turns mode1 on\n    set(p.quiet === undefined ? undefined : p.quiet === 'off' ? 'off' : 'mode1'),\n    set(p.turbo),\n    set(p.lights),\n    set(sensor(p.currentTemperature, '°C')),\n    set(sensor(p.outdoorTemperature, '°C')),\n    set(sensor(p.humidity, '%')),\n    set(p.errorCode === undefined ? '—' : p.errorCode === 0 ? 'none' : String(p.errorCode)),\n    chart, // two messages on one output: room and setpoint series\n];",
    "outputs": 14,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 300,
    "wires": [
      ["d4b0a5d000000013"],
      ["d4b0a5d000000014"],
      ["d4b0a5d000000015"],
      ["d4b0a5d000000016"],
      ["d4b0a5d000000017"],
      ["d4b0a5d000000018"],
      ["d4b0a5d000000019"],
      ["d4b0a5d000000020"],
      ["d4b0a5d000000021"],
      ["d4b0a5d000000023"],
      ["d4b0a5d000000024"],
      ["d4b0a5d000000025"],
      ["d4b0a5d000000026"],
      ["d4b0a5d000000028"]
    ]
  },
  {
    "id": "d4b0a5d000000012",
    "type": "function",
    "name": "Diagnostics → status",
    "func": "// Output 3 of the gree-hvac node: connection state and device info.\nconst d = msg.payload || {};\nif (d.event === 'state') {\n    const text = {\n        connected: 'connected',\n        connecting: 'connecting…',\n        no_response: 'no response (' + (d.streak || '?') + ')',\n        reconnecting: 'reconnecting' + (d.reason ? ' (' + d.reason + ')' : ''),\n        stopped: 'stopped',\n    }[d.to];\n    return text ? [{ payload: text }, null] : null;\n}\nif (d.event === 'device_info') {\n    const version = d.firmwareVersion || d.version || '?';\n    // a firmware whose later builds dropped local control: don't upgrade it\n    return [null, { payload: d.upgradeWarning ? version + ' — do not upgrade' : version }];\n}\nreturn null;",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 560,
    "wires": [["d4b0a5d000000022"], ["d4b0a5d000000027"]]
  },

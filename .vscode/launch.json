{
  // Debug configurations for VS Code (F5). Only this file is tracked.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current test file",
      "runtimeArgs": ["--test"],
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run simulator (UDP 7000, dashboard 8080)",
      "program": "${workspaceFolder}/sim/bin/gree-sim.js",
      "env": {
        "GREE_SIM_BIND": "127.0.0.1",
        "GREE_SIM_HTTP_BIND": "127.0.0.1",
        "GREE_SIM_VERBOSE": "1"
      },
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
